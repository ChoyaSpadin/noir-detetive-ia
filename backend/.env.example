# Chaves gratuitas: https://aistudio.google.com (Gemini) e https://console.groq.com (Groq).
# Sem nenhuma chave o jogo roda no modo offline (respostas por regras) com o caso fixo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Reservas no Groq (cada modelo tem cota própria por minuto), na ordem:
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
ALLOW_OFFLINE=true
MAX_QUESTIONS=25
ALLOWED_ORIGINS=http://localhost:5173

# Vozes da intro (Gemini TTS). Deixe vazio para usar as padrões.
TTS_VOICE_OFFICER=Algenib
TTS_VOICE_NARRATOR=Charon
